<!--
  Sitemap：当前是 SPA（hash 路由），每条 URL 都会进入主页面再由前端路由分发。
  搜索引擎通常无法索引 hash 后的内容（#/levels 等），但展示主页本身已足够。
  如果未来切到 history 路由，可在此处补全各章节关卡的 url。
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://maze.example.com/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
